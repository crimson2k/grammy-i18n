{
  "name": "grammy-i18n",
  "version": "0.1.3",
  "description": "Internationalization (i18n) plugin for Grammy Telegram bot framework with type-safe translations",
  "keywords": [
    "grammy",
    "telegram",
    "bot",
    "i18n",
    "internationalization",
    "localization",
    "translations",
    "typescript"
  ],
  "author": "crimson2k",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crimson2k/grammy-i18n.git"
  },
  "bugs": {
    "url": "https://github.com/crimson2k/grammy-i18n/issues"
  },
  "homepage": "https://github.com/crimson2k/grammy-i18n#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "grammy": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "grammy": "^1.0.0",
    "typescript": "^5"
  }
}
